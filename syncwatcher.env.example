# =============================================================================
# SyncWatcher - Configuración
# =============================================================================

# --- Syncthing ---
SYNCTHING_HOST=syncthing
SYNCTHING_PORT=8384
SYNCTHING_API_KEY=TuAPIKeyDeSyncthing

# --- Gotify ---
GOTIFY_HOST=192.168.88.100
GOTIFY_PORT=8088
GOTIFY_TOKEN=TuTokenDeGotify
SEND_NOTIFICATION=yes

# --- ClamAV REST ---
CLAMAV_HOST=cra
CLAMAV_PORT=3311

# --- Transferr ---
TRANSFERR_HOST=transferr
TRANSFERR_PORT=8000

# --- Butler-API ---
BUTLER_HOST=butler-api
BUTLER_PORT=8000

# --- General ---
LOG_DIR=/var/log/syncwatcher
IDLE_TIMER=120

# =============================================================================
# TIPOS DE ARCHIVO
# Cada tipo define sus extensiones y destinos de transferencia.
# Los destinos son nombres de montajes configurados en Transferr.
# =============================================================================

TYPE1_NAME="LIBROS"
TYPE1_EXT="epub mobi azw3 azw djvu fb2 lit lrf"
TYPE1_DESTINATIONS="calibre booklore"

TYPE2_NAME="MUSICA"
TYPE2_EXT="mp3 flac ogg m4a wav aac opus wma ape alac"
TYPE2_DESTINATIONS="slskd"

TYPE3_NAME="DOCUMENTOS"
TYPE3_EXT="doc docx odt rtf txt md csv xls xlsx ods ppt pptx odp"
TYPE3_DESTINATIONS=""

TYPE4_NAME="BINARIOS"
TYPE4_EXT="exe dll bat cmd sh bin apk dmg pkg msi deb rpm"
TYPE4_DESTINATIONS=""

TYPE5_NAME="IMAGENES"
TYPE5_EXT="jpg jpeg png gif bmp webp tiff svg heic raw cr2 nef"
TYPE5_DESTINATIONS=""

TYPE6_NAME="PDF"
TYPE6_EXT="pdf"
TYPE6_DESTINATIONS=""

TYPE7_NAME="VIDEOS"
TYPE7_EXT="mp4 mkv avi mov wmv flv webm m4v mpeg ts"
TYPE7_DESTINATIONS=""

TYPE8_NAME="COMICS"
TYPE8_EXT="cbz cbr cb7 cbt"
TYPE8_DESTINATIONS="comics"

TYPE9_NAME="COMPRIMIDOS"
TYPE9_EXT="zip rar 7z tar gz bz2 xz zst"
TYPE9_DESTINATIONS=""

# =============================================================================
# CARPETAS MONITOREADAS
#
# FOLDERn_NAME        : nombre descriptivo (solo informativo)
# FOLDERn_ID          : ID de la carpeta en Syncthing
# FOLDERn_SCAN        : tipos a escanear con ClamAV (separados por espacio)
#                       dejar vacío para no escanear
# FOLDERn_COPY        : tipos a transferir conservando el original
# FOLDERn_MOVE        : tipos a transferir eliminando el original tras éxito
# FOLDERn_CARDS       : tipos para los que generar fichas con Butler
#                       dejar vacío para no generar fichas
# =============================================================================

FOLDER1_NAME="Computadora"
FOLDER1_ID="abc12-def34"
FOLDER1_SCAN="BINARIOS COMPRIMIDOS DOCUMENTOS"
FOLDER1_COPY="LIBROS COMICS"
FOLDER1_MOVE="MUSICA"
FOLDER1_CARDS="LIBROS MUSICA COMICS"

# Ejemplo carpeta Paperless (ingest):
# FOLDER2_NAME="Paperless"
# FOLDER2_ID="abc123-def456"
# FOLDER2_SCAN=""
# FOLDER2_COPY=""
# FOLDER2_MOVE="PDF DOCUMENTOS"
# FOLDER2_CARDS=""
